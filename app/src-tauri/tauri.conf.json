{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FangCunSettings",
  "mainBinaryName": "FangCunSettings",
  "version": "0.1.0",
  "identifier": "com.fangcun.ime.settings",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "方寸输入法 设置 & 剪贴板",
        "width": 940,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
