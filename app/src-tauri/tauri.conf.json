{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FangCunSettings",
  "mainBinaryName": "FangCunSettings",
  "version": "0.2.0",
  "identifier": "com.fangcun.ime.settings",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "方寸输入法 设置 & 剪贴板",
        "width": 940,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "clipboard",
        "url": "index.html?mode=clipboard",
        "title": "方寸剪贴板",
        "width": 340,
        "height": 450,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "statusbar",
        "url": "index.html?mode=statusbar",
        "title": "方寸状态栏",
        "width": 196,
        "height": 42,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
